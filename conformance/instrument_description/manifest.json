{
  "format": "makerplane.conformance/1",
  "descriptions": [
    {
      "file": "valid/oil_pressure_dial.yaml",
      "expect": "valid",
      "why": "the worked example of the study"
    },
    {
      "file": "valid/minimal.yaml",
      "expect": "valid",
      "why": "the required fields and one pointer"
    },
    {
      "file": "valid/horizontal_bar.yaml",
      "expect": "valid",
      "why": "an axis scale: fill_bar, offset placement, literal range"
    },
    {
      "file": "valid/limits.yaml",
      "expect": "valid",
      "why": "every bound at its limit, yellow just outside B6's window, red and amber in on_fail, band on a pointer"
    },
    {
      "file": "valid/max_elements.yaml",
      "expect": "valid",
      "why": "exactly 256 elements"
    },
    {
      "file": "invalid/s1_missing_scale.yaml",
      "expect": "S1",
      "why": "the required scale mapping is absent"
    },
    {
      "file": "invalid/s1_offset_on_round_scale.yaml",
      "expect": "S1",
      "why": "ticks on an angle scale are placed by r, not offset"
    },
    {
