    {
      "file": "invalid/b1_visible_if_expression.yaml",
      "expect": "B1",
      "why": "visible_if names a static option, never a condition on the value"
    },
    {
      "file": "invalid/b1_range_expression.yaml",
      "expect": "B1",
      "why": "a range end is a number or aux.Min/aux.Max, never arithmetic"
    },
    {
      "file": "invalid/b1_number_as_string.yaml",
